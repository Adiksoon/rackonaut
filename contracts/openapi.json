{
  "openapi": "3.1.0",
  "info": {
    "title": "Rackonaut inspection API",
    "version": "1.0.0",
    "description": "Shared development contract for observations and inspection results. The reference server uses synthetic fixtures."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service status and mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/inventory/expected": {
      "get": {
        "operationId": "getExpectedInventory",
        "responses": {
          "200": {
            "description": "Expected warehouse inventory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Inventory"
                }
              }
            }
          }
        }
      }
    },
    "/api/observations": {
      "get": {
        "operationId": "getObservations",
        "responses": {
          "200": {
            "description": "Unique observations ordered by capture time",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Observation"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid inspection ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/InspectionId"
          }
        ]
      },
      "post": {
        "operationId": "submitObservation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Observation"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "New observation stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Observation"
                }
              }
            }
          },
          "200": {
            "description": "Identical retry without a new event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Observation"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown storage slot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Observation ID already used with a different payload in this inspection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Expected application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid observation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/discrepancies": {
      "get": {
        "operationId": "getDiscrepancies",
        "responses": {
          "200": {
            "description": "Slots with a discrepancy or requiring review",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SlotResult"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid inspection ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/InspectionId"
          }
        ]
      }
    },
    "/api/summary": {
      "get": {
        "operationId": "getSummary",
        "responses": {
          "200": {
            "description": "Latest observation and outcome for every expected slot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          },
          "422": {
            "description": "Invalid inspection ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/InspectionId"
          }
        ]
      }
    }
  },
  "components": {
    "parameters": {
      "InspectionId": {
        "name": "inspection_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^INS-[A-Z0-9]+(?:-[A-Z0-9]+)*$(?![\\s\\S])",
          "maxLength": 64,
          "default": "INS-001"
        },
        "description": "Inspection to query. The fixture inspection is INS-001."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "mode"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "mode": {
            "type": "string"
          }
        }
      },
      "Observation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "inspection_id",
          "observation_id",
          "slot_id",
          "pallet_id",
          "occupancy",
          "label_status",
          "timestamp"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0"
          },
          "inspection_id": {
            "type": "string",
            "pattern": "^INS-[A-Z0-9]+(?:-[A-Z0-9]+)*$(?![\\s\\S])",
            "maxLength": 64
          },
          "observation_id": {
            "type": "string",
            "pattern": "^OBS-[A-Z0-9]+(?:-[A-Z0-9]+)*$(?![\\s\\S])",
            "maxLength": 64
          },
          "slot_id": {
            "type": "string",
            "pattern": "^[A-Z]-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"
          },
          "pallet_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^P[0-9]{3}$(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "occupancy": {
            "type": "string",
            "enum": [
              "empty",
              "occupied",
              "uncertain"
            ]
          },
          "label_status": {
            "type": "string",
            "enum": [
              "readable",
              "unreadable",
              "not_applicable",
              "unknown"
            ]
          },
          "timestamp": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$(?![\\s\\S])",
            "format": "date-time"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "occupancy": {
                  "const": "empty"
                }
              }
            },
            "then": {
              "properties": {
                "pallet_id": {
                  "type": "null"
                },
                "label_status": {
                  "const": "not_applicable"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "occupancy": {
                  "const": "occupied"
                }
              }
            },
            "then": {
              "properties": {
                "label_status": {
                  "enum": [
                    "readable",
                    "unreadable"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "occupancy": {
                  "const": "uncertain"
                }
              }
            },
            "then": {
              "properties": {
                "pallet_id": {
                  "type": "null"
                },
                "label_status": {
                  "const": "unknown"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "label_status": {
                  "const": "readable"
                }
              }
            },
            "then": {
              "properties": {
                "pallet_id": {
                  "type": "string",
                  "pattern": "^P[0-9]{3}$(?![\\s\\S])"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "label_status": {
                  "const": "unreadable"
                }
              }
            },
            "then": {
              "properties": {
                "pallet_id": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "ExpectedLocation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "pallet_id"
        ],
        "properties": {
          "slot_id": {
            "type": "string",
            "pattern": "^[A-Z]-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"
          },
          "pallet_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^P[0-9]{3}$(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Inventory": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "locations"
        ],
        "properties": {
          "source": {
            "type": "string",
            "const": "mock_sap"
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpectedLocation"
            }
          }
        }
      },
      "SlotResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "expected_pallet_id",
          "observed_pallet_id",
          "observation_id",
          "outcome"
        ],
        "properties": {
          "slot_id": {
            "type": "string",
            "pattern": "^[A-Z]-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"
          },
          "expected_pallet_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^P[0-9]{3}$(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "observed_pallet_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^P[0-9]{3}$(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "observation_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^OBS-[A-Z0-9]+(?:-[A-Z0-9]+)*$(?![\\s\\S])",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "match",
              "wrong_pallet",
              "missing_pallet",
              "unexpected_pallet",
              "unreadable_label",
              "uninspected",
              "uncertain",
              "pending"
            ]
          }
        }
      },
      "Summary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inspection_id",
          "slots_total",
          "slots_observed",
          "observations_total",
          "discrepancy_count",
          "outcomes",
          "slots"
        ],
        "properties": {
          "inspection_id": {
            "type": "string",
            "pattern": "^INS-[A-Z0-9]+(?:-[A-Z0-9]+)*$(?![\\s\\S])",
            "maxLength": 64
          },
          "slots_total": {
            "type": "integer",
            "minimum": 0
          },
          "slots_observed": {
            "type": "integer",
            "minimum": 0
          },
          "observations_total": {
            "type": "integer",
            "minimum": 0
          },
          "discrepancy_count": {
            "type": "integer",
            "minimum": 0
          },
          "outcomes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "match",
              "wrong_pallet",
              "missing_pallet",
              "unexpected_pallet",
              "unreadable_label",
              "uninspected",
              "uncertain",
              "pending"
            ],
            "properties": {
              "match": {
                "type": "integer",
                "minimum": 0
              },
              "wrong_pallet": {
                "type": "integer",
                "minimum": 0
              },
              "missing_pallet": {
                "type": "integer",
                "minimum": 0
              },
              "unexpected_pallet": {
                "type": "integer",
                "minimum": 0
              },
              "unreadable_label": {
                "type": "integer",
                "minimum": 0
              },
              "uninspected": {
                "type": "integer",
                "minimum": 0
              },
              "uncertain": {
                "type": "integer",
                "minimum": 0
              },
              "pending": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlotResult"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}

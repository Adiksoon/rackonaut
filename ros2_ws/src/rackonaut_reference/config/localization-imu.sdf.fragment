      <sensor name="local_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>/rackonaut_reference/local_imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><stddev>0.001</stddev><bias_stddev>0.00012</bias_stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.001</stddev><bias_stddev>0.00012</bias_stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.001</stddev><bias_stddev>0.00012</bias_stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><stddev>0.028</stddev><bias_stddev>0.007</bias_stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.028</stddev><bias_stddev>0.007</bias_stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.028</stddev><bias_stddev>0.007</bias_stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

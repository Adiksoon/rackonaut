<?xml version="1.0"?>
<package format="3">
  <name>rackonaut_control</name>
  <version>0.1.0</version>
  <description>Local web mission control for the Rackonaut simulator.</description>
  <maintainer email="rackonaut@example.invalid">Rackonaut team</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rackonaut_avoidance</exec_depend>
  <exec_depend>rackonaut_mission</exec_depend>
  <exec_depend>rackonaut_perception</exec_depend>
  <exec_depend>rackonaut_reference</exec_depend>
  <exec_depend>rackonaut_safety</exec_depend>
  <exec_depend>rackonaut_warehouse</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rackonaut_energy</exec_depend>
  <exec_depend>rackonaut_localization</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
